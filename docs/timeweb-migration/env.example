# ================================================================
# .env.local — переменные окружения для подключения к Timeweb
# Скопировать в корень проекта как .env.local
# НЕ коммитить в git!
# ================================================================

# ----------------------------------------------------------------
# PostgREST API (замена Supabase REST API)
# Формат: https://ВАШ_ДОМЕН_ИЛИ_IP/  (без /rest/v1 в конце — PostgREST сам роутит)
# ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://5.42.107.149:3000

# ----------------------------------------------------------------
# Anon JWT токен для PostgREST
# Генерация: node -e "const jwt=require('jsonwebtoken'); console.log(jwt.sign({role:'anon',iss:'postgrest'},process.env.JWT_SECRET))"
# ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiZ2VuX3VzZXIiLCJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTc3MjYzMjA4MywiZXhwIjo0MDcwOTA4ODAwfQ.O0frbJsIkHqhCNIcgf2gc39-QwsvC37MjN74SiHjijQ

# ----------------------------------------------------------------
# Service role JWT (для серверных API routes, admin)
# ----------------------------------------------------------------
# Service role JWT for PostgREST — same gen_user role (Timeweb has no service_role)
# Note: On Supabase, replace this with the real service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiZ2VuX3VzZXIiLCJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTc3MjYzMjA4MywiZXhwIjo0MDcwOTA4ODAwfQ.O0frbJsIkHqhCNIcgf2gc39-QwsvC37MjN74SiHjijQ

# ----------------------------------------------------------------
# JWT Secret (Legacy HS256) — тот же используется в PostgREST PGRST_JWT_SECRET
# ----------------------------------------------------------------
SUPABASE_JWT_SECRET=lv6TM54b6jgju4maOjCNHbOnofqg2GN9ZlqpfYteoqa2J0H24sz8TQAY4SZrAGosSbJlbsZtNG6HOSVSN648Nw==

# ----------------------------------------------------------------
# Роль в JWT токенах для gen_user (Timeweb не поддерживает anon/authenticated роли)
# ----------------------------------------------------------------
DB_JWT_ROLE=gen_user

# ----------------------------------------------------------------
# Прямое подключение к Timeweb PostgreSQL (для server-side запросов)
# Используется в API routes напрямую (если решите убрать PostgREST)
# ----------------------------------------------------------------
DATABASE_URL=postgres://gen_user:3WdY%29K%3C%7B%3DMc%3DrJ@5.42.107.149:5432/default_db?sslmode=require

# ----------------------------------------------------------------
# Vercel Analytics — удалить при переезде на Yandex/Timeweb
# ----------------------------------------------------------------
# VERCEL_ANALYTICS_ID=...

# ----------------------------------------------------------------
# Аудио активы (уже на Yandex Object Storage — не менять)
# ----------------------------------------------------------------
NEXT_PUBLIC_AUDIO_BASE=https://storage.yandexcloud.net/vecherinkach/audio
